# Copy to .env and fill in only what you use. .env is git-ignored. This file has NAMES ONLY.

# ---- Core
DATABASE_URL=
PORT=
HOST=
JWT_SECRET=
PUBLIC_BASE_URL=
PUBLIC_SITE_URL=
UPLOAD_DIR=

# ---- Delivery (dry-run by default; smtp/live only for approved tests)
MAIL_MODE=
MESSAGE_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NETTYFISH_USER=
NETTYFISH_PASSWORD=
NETTYFISH_SENDER_ID=
