# ---- Admin log viewer (/admin/api). Master key for logging in to the admin log API.
# Leave empty to disable the admin log API (every login then fails with 503). Use a long random value.
ADMIN_LOG_KEY=

# Browser origins allowed to call the API (comma separated). Unset allows all (development only).
CORS_ORIGINS=
