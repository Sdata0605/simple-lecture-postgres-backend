# systemd unit for the backend on the server. TEMPLATE ONLY: not installed.
# Install only after the user approves the server change.
[Unit]
Description=SimpleLecture backend (Express: auth and edge functions)
After=network.target postgresql@14-main.service

[Service]
Type=simple
User=simplelecture
WorkingDirectory=/home/simplelecture/simplelecture-backend
EnvironmentFile=/home/simplelecture/simplelecture-backend/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
